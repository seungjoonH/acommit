    "@google/generative-ai": "^0.24.1",
    "chalk": "^5.6.0",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.3",
    "openai": "^6.8.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.1"
  }
